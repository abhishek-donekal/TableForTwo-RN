// ─────────────────────────────────────────────────────────────────────────────
//  Table for Two — Prisma Schema
//  Database: PostgreSQL (Neon / Supabase / PlanetScale)
//  Generated by: Agent 7 — Database Engineer
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum BGCheckStatus {
  PENDING      // Just registered
  SUBMITTED    // Fee paid, check initiated
  IN_PROGRESS  // Background check provider is running the check
  CLEAR        // Passed — can broadcast
  FLAGGED      // Review needed
  FAILED       // Rejected from platform
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
}

enum Orientation {
  STRAIGHT
  GAY
  LESBIAN
  BISEXUAL
  PANSEXUAL
  OTHER
}

enum IncomeRange {
  RANGE_50K_100K
  RANGE_100K_200K
  RANGE_200K_500K
  RANGE_500K_PLUS
}

enum BroadcastStatus {
  ACTIVE     // Open for matching
  MATCHED    // 2-3 candidates sent, awaiting acceptance
  LOCKED     // Both accepted, holds placed
  EXPIRED    // No match accepted in time
  CANCELLED  // Broadcaster withdrew
}

enum MatchStatus {
  PENDING            // Waiting for both parties
  BROADCASTER_ACCEPTED
  CANDIDATE_ACCEPTED
  BOTH_ACCEPTED      // Triggers hold
  DECLINED           // Either party declined
  EXPIRED
}

enum HoldStatus {
  PENDING
  AUTHORIZED   // Stripe manual-capture hold placed
  RELEASED     // Date completed — hold cancelled
  CAPTURED     // Bail penalty forfeited
  FAILED
}

enum CommitmentStatus {
  AWAITING_HOLDS     // Accepted, waiting for both Stripe holds
  HOLDS_PLACED       // Both $50 holds authorized
  DATE_ACTIVE        // Date window open, GPS tracking live
  COMPLETED          // Date went ahead — holds released
  FORFEITED_USER1    // User 1 bailed — their $50 captured
  FORFEITED_USER2    // User 2 bailed — their $50 captured
  CANCELLED_MUTUAL   // Both agreed to cancel — refunded
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  REFUNDED
  CANCELLED
}

enum TransactionType {
  JOINING_FEE
  HOLD_AUTHORIZATION
  HOLD_RELEASE
  HOLD_CAPTURE
  VENDOR_BOOKING
  PLATFORM_COMMISSION
  VENDOR_PAYOUT
}

// ─────────────────────────────────────────────────────────────────────────────
//  USER — Core profile with strict preferences
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  firstName String
  lastName  String
  dateOfBirth DateTime
  age       Int      // Computed/denormalized for fast queries

  // ── Identity & Orientation
  gender      Gender
  orientation Orientation

  // ── Physical attributes (matching criteria)
  heightCm    Int        // e.g. 175

  // ── Financial standing (self-reported, honesty enforced by bg check)
  incomeRange IncomeRange

  // ── Location
  zipCode   String
  city      String?
  state     String?

  // ── Biography
  bio       String?  @db.Text
  profession String?

  // ── Hard preferences for matching (ALL must be satisfied)
  prefGenders       Gender[]       // Acceptable genders in a match
  prefOrientations  Orientation[]  // Acceptable orientations
  prefHeightMinCm   Int            // Min acceptable height of match
  prefHeightMaxCm   Int            // Max acceptable height of match
  prefIncomeRanges  IncomeRange[]  // Acceptable income ranges
  prefAgeMin        Int            @default(21)
  prefAgeMax        Int            @default(100)

  // ── Background check
  bgCheckStatus       BGCheckStatus  @default(PENDING)
  bgCheckProvider     String?        // 'Checkr' | 'Certn' | 'Sterling'
  bgCheckProviderId   String?        // Provider's internal check ID
  bgCheckCompletedAt  DateTime?
  bgCheckNotes        String?        @db.Text  // Admin-visible notes

  // ── Joining fee (one-time, unlocks broadcasts)
  hasJoiningFee        Boolean  @default(false)
  joiningFeeAmountUsd  Int?     // In cents (e.g. 2999 = $29.99)
  joiningFeeStripeId   String?  // Stripe PaymentIntent ID for joining fee

  // ── Stripe billing
  stripeCustomerId       String?  @unique
  stripePaymentMethodId  String?  // Default saved card for holds

  // ── Platform membership
  isActive      Boolean  @default(true)
  isBanned      Boolean  @default(false)
  banReason     String?

  // ── Relations
  broadcasts    DateBroadcast[]    @relation("BroadcasterBroadcasts")
  matchesAsCandidate DateMatch[]   @relation("CandidateMatches")
  commitmentsAsUser1 DateCommitment[] @relation("CommitmentUser1")
  commitmentsAsUser2 DateCommitment[] @relation("CommitmentUser2")
  transactions  Transaction[]
  liveLocations LiveLocation[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([zipCode, bgCheckStatus, hasJoiningFee, isActive])
  @@index([gender, orientation, heightCm, incomeRange, age])
}

// ─────────────────────────────────────────────────────────────────────────────
//  DATE BROADCAST — A user announces availability
// ─────────────────────────────────────────────────────────────────────────────

model DateBroadcast {
  id            String          @id @default(cuid())
  broadcasterId String
  broadcaster   User            @relation("BroadcasterBroadcasts", fields: [broadcasterId], references: [id])

  zipCode       String
  intentType    String          // 'Dinner' | 'Drinks' | 'Coffee' | 'Cultural'
  scheduledFor  DateTime        // The actual date/time proposed
  expiresAt     DateTime        // Auto-cancel if no match accepts

  status        BroadcastStatus @default(ACTIVE)

  // Cached snapshot of broadcaster's prefs at broadcast time
  // (prevents retroactive pref-change gaming)
  prefSnapshot  Json

  matches       DateMatch[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([zipCode, status, scheduledFor])
  @@index([broadcasterId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
//  DATE MATCH — One broadcaster ↔ one candidate pair
//  Max 3 matches per broadcast (enforced at application layer)
// ─────────────────────────────────────────────────────────────────────────────

model DateMatch {
  id           String      @id @default(cuid())
  broadcastId  String
  broadcast    DateBroadcast @relation(fields: [broadcastId], references: [id])

  candidateId  String
  candidate    User        @relation("CandidateMatches", fields: [candidateId], references: [id])

  status       MatchStatus @default(PENDING)

  // Idempotency key — prevents double-acceptance on retry/tap
  acceptanceKey String     @unique @default(cuid())

  broadcasterAcceptedAt DateTime?
  candidateAcceptedAt   DateTime?
  declinedAt            DateTime?
  declinedBy            String?   // userId who declined

  commitment   DateCommitment?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([broadcastId, candidateId])
  @@index([broadcastId, status])
  @@index([candidateId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
//  DATE COMMITMENT — Locked date with Stripe holds
// ─────────────────────────────────────────────────────────────────────────────

model DateCommitment {
  id      String  @id @default(cuid())
  matchId String  @unique
  match   DateMatch @relation(fields: [matchId], references: [id])

  user1Id String
  user1   User    @relation("CommitmentUser1", fields: [user1Id], references: [id])
  user2Id String
  user2   User    @relation("CommitmentUser2", fields: [user2Id], references: [id])

  // ── Stripe $50 holds (capture_method: 'manual')
  user1PaymentIntentId String?
  user2PaymentIntentId String?
  user1HoldStatus      HoldStatus @default(PENDING)
  user2HoldStatus      HoldStatus @default(PENDING)
  holdAmountCents      Int        @default(5000)  // $50

  // ── State machine
  status               CommitmentStatus @default(AWAITING_HOLDS)

  // ── Date window
  dateWindowStart      DateTime?  // When GPS tracking begins
  dateWindowEnd        DateTime?  // When GPS tracking ends

  // ── Settlement
  settledAt    DateTime?
  forfeitedBy  String?   // userId who bailed — their hold is captured

  // ── Vendor bookings
  venueBooking     VenueBooking?
  transportBooking TransportBooking?
  giftBooking      GiftBooking?

  // ── GPS data
  liveLocations    LiveLocation[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([user1Id, status])
  @@index([user2Id, status])
}

// ─────────────────────────────────────────────────────────────────────────────
//  VENDOR BOOKINGS — OpenTable / Lyft / 1-800-Flowers
//  All go through Stripe Connect — 10% platform commission retained
// ─────────────────────────────────────────────────────────────────────────────

model VenueBooking {
  id            String  @id @default(cuid())
  commitmentId  String  @unique
  commitment    DateCommitment @relation(fields: [commitmentId], references: [id])

  vendor              String        // 'OpenTable' | 'Resy'
  vendorAccountId     String        // Stripe Connect account ID of vendor
  vendorExternalRef   String?       // Vendor's own booking reference

  totalAmountCents    Int           // Full customer charge
  platformFeeCents    Int           // 10% retained
  vendorPayoutCents   Int           // 90% transferred to vendor

  stripePaymentIntentId String?
  stripeTransferId      String?     // Transfer to vendor Connect account

  status        BookingStatus @default(PENDING)
  reservedFor   DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TransportBooking {
  id            String  @id @default(cuid())
  commitmentId  String  @unique
  commitment    DateCommitment @relation(fields: [commitmentId], references: [id])

  vendor              String        // 'Lyft' | 'Uber'
  vendorAccountId     String
  vendorExternalRef   String?       // Lyft ride ID

  totalAmountCents    Int
  platformFeeCents    Int
  vendorPayoutCents   Int

  stripePaymentIntentId String?
  stripeTransferId      String?

  status        BookingStatus @default(PENDING)
  pickupAddress String?
  dropoffAddress String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model GiftBooking {
  id            String  @id @default(cuid())
  commitmentId  String  @unique
  commitment    DateCommitment @relation(fields: [commitmentId], references: [id])

  vendor              String        // '1800Flowers' | 'Teleflora'
  vendorAccountId     String
  vendorExternalRef   String?

  totalAmountCents    Int
  platformFeeCents    Int
  vendorPayoutCents   Int

  stripePaymentIntentId String?
  stripeTransferId      String?

  status        BookingStatus @default(PENDING)
  deliveryAddress String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
//  TRANSACTION LEDGER — Immutable audit log of all money movement
// ─────────────────────────────────────────────────────────────────────────────

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])

  type          TransactionType
  amountCents   Int
  currency      String          @default("usd")
  description   String

  stripeId      String?         // Stripe PaymentIntent / Transfer ID
  commitmentId  String?
  vendorBookingRef String?

  metadata      Json?

  createdAt     DateTime  @default(now())

  @@index([userId, type])
  @@index([commitmentId])
}

// ─────────────────────────────────────────────────────────────────────────────
//  LIVE LOCATION — GPS during active date window only
//  Purged 24h after date window closes (GDPR / privacy)
// ─────────────────────────────────────────────────────────────────────────────

model LiveLocation {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id])
  commitmentId  String
  commitment    DateCommitment @relation(fields: [commitmentId], references: [id])

  latitude      Float
  longitude     Float
  accuracyM     Float?
  altitude      Float?

  // Auto-purge via Vercel cron or pg_cron after 24h
  purgeAfter    DateTime

  createdAt     DateTime  @default(now())

  @@index([commitmentId, userId, createdAt])
}
