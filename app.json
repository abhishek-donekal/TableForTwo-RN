{
  "expo": {
    "name": "Table for 2",
    "slug": "table-for-two",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "tablefortwo",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0A13"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rkdtech.tablefortwo",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0A13"
      },
      "package": "com.rkdtech.tablefortwo"
    },
    "plugins": [
      "expo-asset"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo.jpeg"
    },
    "extra": {
      "eas": {
        "projectId": "031cebf0-a5b3-425b-8004-93803e599f02"
      }
    },
    "owner": "duryo"
  }
}
